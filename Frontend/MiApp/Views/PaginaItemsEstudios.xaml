<Page x:Class="ProyectoTurnos_FrontEnd.MiApp.Views.PaginaItemsEstudios"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:ProyectoTurnos_FrontEnd.MiApp.Models"
      mc:Ignorable="d"
      Title="PaginaItemsEstudios" Background="#FDF6EC">

    <Grid>

        <!-- Loader mientras carga -->
        <Border x:Name="LoaderPanel" Background="#FDF6EC" />

        <Border CornerRadius="5" Width="70" Height="50" BorderBrush="#DDD" BorderThickness="1" Margin="20,20,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Button Click="Volver" Content="Volver" FontWeight="SemiBold" Foreground="#145A54" Cursor="Hand"
                    BorderBrush="Transparent" BorderThickness="0" Background="Transparent" />
        </Border>

        <Grid x:Name="PaginaDatos" Width="850" VerticalAlignment="Stretch" HorizontalAlignment="Center"
              Margin="15,25,15,25" Background="Transparent">
            <Border CornerRadius="8" BorderBrush="#CCC" BorderThickness="1.5" Background="#FDF6EC">
                <Grid HorizontalAlignment="Center" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Width="850" Grid.Row="0" BorderBrush="#145A54" BorderThickness="0,0,0,1.5" CornerRadius="2"
                            Background="#FFF9F2">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#145A54" Margin="5,5,0,0" BorderThickness="1.5"
                                    CornerRadius="2" Width="120" Height="Auto" Background="#FFF9F2">
                                <Button Content="Cargar registro" Foreground="#2C4B56" Click="RedirigirACreacionItem"
                                        FontSize="14" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                        Width="120" Height="28" Background="Transparent" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Padding="10" Background="#FDF6EC">
                        <Grid Width="Auto" MaxWidth="600">
                            <ItemsControl x:Name="ListaItemsEstudio" Visibility="Hidden">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ItemEstudioDTO}"> <!--Indica que es una lista de ItemEstudio-->
                                        <Border BorderBrush="#DDD" BorderThickness="1.2" Margin="10,8,10,8"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Padding="10" VerticalAlignment="Center"
                                                        Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding fecha}" Foreground="#2C4B56"
                                                               FontSize="20" FontWeight="SemiBold" />
                                                </Border>
                                                
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding estudios}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:EstudioDTO}"> <!--Indica que es una lista de EstudioDTO-->
                                                            <Border Grid.Column="1"
                                                                    BorderBrush="#145A54" Margin="0,0,15,0"
                                                                    BorderThickness="1.5" CornerRadius="2"
                                                                    Width="120" Height="Auto"
                                                                    Background="#FFF9F2">
                                                                <Button FontWeight="SemiBold"
                                                                        Content="{Binding nombre}"
                                                                        Foreground="#2C4B56" FontSize="14"
                                                                        BorderThickness="0" Cursor="Hand"
                                                                        Width="120" Height="28"
                                                                        Background="Transparent" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                                
                                                <!--
                                                <Border Grid.Column="1" Padding="10">
                                                    <Grid>
                                                        <ItemsControl>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#DDD" CornerRadius="5"
                                                                            Margin="5">
                                                                        <Grid>

                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                                -->
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>