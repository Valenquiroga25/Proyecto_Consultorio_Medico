<Window x:Class="ProyectoTurnos_FrontEnd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Aplicación Consultorio Dr. Quiroga"
        WindowState="Maximized">
    <Grid>
        <!--Se generó la clase MainWindow para agregar acá el Frame, que es quien nos permite navegar entre páginas-->
        <!--Es la única función de la clase, se hizo de esta manera para que la navegacion no sea en base a cierres y aperturas de ventanas.-->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />
    </Grid>
</Window>