<Page x:Class="ProyectoTurnos_FrontEnd.MiApp.Views.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Login" Height="450" Width="800">
    <Grid>
        <Viewbox Stretch="Uniform"> <!-- Para que se ocupe el total del layout-->
            <Border Background="#FEFEF0" BorderBrush="DarkGray" BorderThickness="3" Width="600" Height="550"
                    CornerRadius="8">
                <!-- StackPanel centrado -->
                <StackPanel
                    HorizontalAlignment="Center">
                    <!--Título del login (Lo único que se encuentra en la primera fila)-->
                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        FontFamily="Segoe UI"
                        Foreground="#2C4B56"
                        Margin="0,35,0,0"
                        HorizontalAlignment="Center"
                        TextAlignment="Center">
                        Centro Médico Dr. Quiroga
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FEFEFE" BlurRadius="5" ShadowDepth="2" Opacity="0.5" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <Label FontSize="19" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#7BAF9E"
                           Margin="0,50,0,0">
                        Usuario
                    </Label>
                    <Border Width="400" Height="40" CornerRadius="8" BorderBrush="DarkGray" BorderThickness="2"
                            Background="#FEFEFE">
                        <TextBox x:Name="usuarioForm" Padding="10,5,10,10" Background="Transparent" BorderThickness="0"
                                 FontSize="18" FontWeight="SemiBold" Foreground="DarkBlue"/>
                    </Border>

                    <Label FontSize="19" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#7BAF9E"
                           Margin="0,30,0,0">
                        Contraseña
                    </Label>
                    <Grid>
                        <Border Width="400" Height="40" CornerRadius="8" BorderBrush="DarkGray" BorderThickness="2"
                                Background="#FEFEFE">
                            <PasswordBox x:Name="contraseniaForm" Padding="10,7,10,10" Background="Transparent"
                                     BorderThickness="0" FontSize="18" FontWeight="SemiBold" Foreground="DarkBlue" 
                                     MaxLength="25" PasswordChar="*"/>
                        </Border>

                        <TextBox Name="PasswordUnmask" Visibility="Hidden" Padding="10,7,10,10" Background="Transparent"
                                 BorderThickness="0" FontSize="18" FontWeight="SemiBold" Foreground="DarkBlue" 
                                 MaxLength="25"/>
                    </Grid>
                    
                    <Border Width="100" Height="40" Background="#CFFFD0" BorderBrush="#6E89A2" BorderThickness="1.5"
                            CornerRadius="8" Margin="0,10,0,0">
                        <TextBlock x:Name="ShowPassword" Text="Mostrar" VerticalAlignment="Center" HorizontalAlignment="Center"  Foreground="#3A506B" FontSize="18" FontWeight="SemiBold" PreviewMouseDown="ShowPassword_PreviewMouseDown" PreviewMouseUp="ShowPassword_PreviewMouseUp" MouseLeave="ShowPassword_MouseLeave"/>
                    </Border>
                    
                    <Border Width="300" Height="52" Background="#CFFFD0" BorderBrush="#6E89A2" BorderThickness="1.5"
                            CornerRadius="8" Margin="10,70,10,10">
                        <Button Content="Iniciar sesión"
                                Background="Transparent"
                                FontWeight="SemiBold"
                                Foreground="#3A506B"
                                BorderThickness="0"
                                FontSize="19"
                                Cursor="Hand"
                                Click="OnClick" 
                                IsDefault="True" /> <!--IsDefault se usa para apretar enter y que se dispare la acción-->
                    </Border>
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</Page>