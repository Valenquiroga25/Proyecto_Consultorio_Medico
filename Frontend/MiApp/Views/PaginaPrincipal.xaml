<Page x:Class="ProyectoTurnos_FrontEnd.MiApp.Views.PaginaPrincipal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:config="clr-namespace:ProyectoTurnos_FrontEnd.MiApp.Config"
      mc:Ignorable="d"
      Title="PaginaPrincipal">
    
    <Page.Resources>
        <config:Placeholder x:Key="Placeholder" /> <!--x:Key="EmptyTextToVisibility" define el nombre con el cual lo vas a referenciar luego.-->
    </Page.Resources>
    
    <StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="Titulo" Margin="0,60,0,30" FontStyle="Italic" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C4B56"/>
            
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions> 
                
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,80,0">
                    <Border CornerRadius="8" BorderBrush="DarkGray" BorderThickness="1.2" Height="252" Width="350">
                        <Image Source="C:\Users\54345\OneDrive\Escritorio\ProyectoTurnos_FrontEnd\ProyectoTurnos_FrontEnd\MiApp\Assets\Estudio2.jpg" Height="250" Width="350" Margin="10"/>
                    </Border>
                    
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="250" CornerRadius="5" BorderBrush="#DDD" BorderThickness="1.5" Height="40" Margin="10,19,10,10" >
                            <Button FontSize="15" Foreground="#2C4B56" FontWeight="SemiBold"
                                    Content="Generar Historia Clínica" Background="Transparent" Click="OnClick"
                                    Cursor="Hand" Height="50" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!--Filtro y botón -->
                            <Grid Margin="15,20,-7,10" HorizontalAlignment="Center">
                                <Border MinWidth="200" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,20,0">
                                    <TextBox x:Name="Filtro" TextChanged="GetHistoriasFiltradas" MinWidth="150" Height="20" FontWeight="Medium" FontSize="13" Margin="7" Background="Transparent" BorderThickness="0"/>                                
                                </Border> 

                                <!--IsHitTestVisible="False": evita que el TextBlock intercepte el clic (el clic pasa directo al TextBox).-->
                                <TextBlock Text="Buscar paciente..."
                                           IsHitTestVisible="False" 
                                           Foreground="Gray"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Text, ElementName=Filtro, Converter={StaticResource Placeholder}}"/>
                            </Grid>
                            
                            <StackPanel Grid.Row="1" x:Name="ListaHistorias" Visibility="Hidden" Width="Auto" MinWidth="340" MaxWidth="600">
                                <ItemsControl x:Name="TablaHistorias" ItemsSource="historias">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDD" BorderThickness="1.2" Margin="10,8,10,8" CornerRadius="5">
                                                <Button HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Height="50" Cursor="Hand" Click="RedirigirAHistoria">
                                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <!--Datos del paciente-->
                                                        <TextBlock Text="{Binding apellidos}" FontSize="16" Foreground="#566573" FontStyle="Italic" Margin="0,-1.1,0,0"/>
                                                        <TextBlock Text=", " FontSize="16" Foreground="#566573" FontStyle="Italic" Margin="0,-1.1,0,0"/>
                                                        <TextBlock Text="{Binding nombres}" FontSize="16" Foreground="#566573" FontStyle="Italic" Margin="0,-1.1,0,0"/>
                                                        <TextBlock Text="-  DNI: " FontSize="15" Foreground="#566573" Margin="9,-0.5,0,0"/>
                                                        <TextBlock Text="{Binding documentoPaciente}" FontSize="15" Foreground="#566573" Margin="3,-0.5,8,0"/>
                                                    </WrapPanel>
                                                </Button>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1">
                    <Border CornerRadius="8" BorderBrush="DarkGray" BorderThickness="1.2" Height="250" Width="350" Margin="0,0,10,20">
                        <Image Source="C:\Users\54345\OneDrive\Escritorio\ProyectoTurnos_FrontEnd\ProyectoTurnos_FrontEnd\MiApp\Assets\Calendario.jpg" Height="250" Width="350" Margin="10"/>
                    </Border>
                    
                    <StackPanel MaxWidth="250">
                        <Border CornerRadius="5" BorderBrush="#DDD" BorderThickness="1.5" Height="40" >
                            <Button x:Name="AgendaDeTurnos" FontSize="15" Foreground="#2C4B56" FontWeight="SemiBold"
                                    Content="Agenda de Turnos" Background="Transparent" Click="OnClick"
                                    Cursor="Hand" Height="40" BorderThickness="0" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </StackPanel>
    
</Page>